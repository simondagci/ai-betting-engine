# ==============================================================================
# AI BETTING ENGINE - ÖRNEK ÇEVRE DEĞİŞKENLERİ (.env.example)
# ==============================================================================
# Bu dosyayı .env olarak kopyalayıp kendi anahtarınızı girin:
# cp .env.example .env

# Google Gemini API Anahtarınız (Zorunlu)
GEMINI_API_KEY=your_gemini_api_key_here

# Kullanılacak Gemini Modeli
GEMINI_MODEL=gemini-3.8-flash

# Gemini Analizlerini Genel Olarak Aktif Etme (True / False)
ENABLE_GEMINI_ANALYSIS=False

# Sadece Veritabanında İzin Verilen Liglerin Analiz Edilmesi (True / False)
REQUIRE_LEAGUE_APPROVAL=True

# Yeni Eklenen Liglerin Varsayılan Analiz Durumu (0: Kapalı, 1: Açık)
DEFAULT_LEAGUE_GEMINI_ANALYSIS=0

# Maç Tamamlandı Süre Eşiği (Maç başlama saatinden kaç dakika sonra bitti sayılsın)
MATCH_COMPLETION_DELAY_MINUTES=150

# Banko Kupon İçin Minimum Güven Oranı (0 - 100)
MIN_CONFIDENCE_FOR_COUPON=70

# Toplu Analizlerde İstekler Arası Bekleme Süresi (Saniye)
BATCH_REQUEST_DELAY=1.5

# Toplu analizde aynı anda Gemini'ye gönderilen maç sayısı (artırmak hızlandırır, 429 limit riskini artırır)
GEMINI_PARALLEL_REQUESTS=3

# 2. tercih eşiği: ⭐ en güçlü tercihin oranı bunun altındaysa oranı eşik ve üstü bir 2. tercih de kaydedilir
MIN_BEST_BET_ODDS=1.30

# Tek bir Gemini isteği için zaman aşımı (saniye)
GEMINI_TIMEOUT_SECONDS=120

# Veritabanı Dosya Yolu (Opsiyonel)
DB_FILE_PATH=betting_engine.db

# Veri Kaynağı: iddaa (önerilen) veya nesine
# Nesine istatistik servisleri Türkiye dışından erişimi engeller.
DATA_SOURCE=iddaa

# Saat Dilimi Ayarları
SOURCE_TIMEZONE=Europe/Istanbul
DISPLAY_TIMEZONE=Europe/Berlin
